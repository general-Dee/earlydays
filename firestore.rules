rules_version = '2';

// Payment writes only ever happen via the Admin SDK (server routes
// bypass these rules), so `payments` is client-write:false here.
//
// Audited 2026-08-24: every client-side Firestore read in components/
// (parents/{uid}, parents/{uid}/payments, parents/{uid}/reports,
// announcements, events) is covered by a matching rule below, and no
// client code reads applications/inquiries (admin-only, Admin SDK).
// Not a substitute for a full professional security review. Covered by
// automated tests in test/rules/firestore.rules.test.ts (run via
// `npm run test:rules`) — update that suite when you change a rule here.
service cloud.firestore {
  match /databases/{database}/documents {
    match /parents/{uid} {
      allow read, update: if request.auth != null && request.auth.uid == uid;
      allow create: if request.auth != null && request.auth.uid == uid;
      allow delete: if false;

      match /payments/{reference} {
        allow read: if request.auth != null && request.auth.uid == uid;
        allow write: if false;
      }

      match /reports/{reportId} {
        allow read: if request.auth != null && request.auth.uid == uid;
        allow write: if false;
      }
    }

    match /announcements/{id} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    match /events/{id} {
      allow read: if true;
      allow write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
