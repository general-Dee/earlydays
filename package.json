{
  "name": "earlydays",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "node scripts/validate-env.mjs && next build",
    "analyze": "cross-env ANALYZE=true next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "firebase emulators:exec --only firestore --project demo-earlydays \"playwright test\"",
    "test:rules": "firebase emulators:exec --only firestore,storage --project demo-earlydays \"vitest run --config vitest.rules.config.ts\"",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{js,jsx,mjs,ts,tsx}": [
      "eslint --fix"
    ]
  },
  "dependencies": {
    "@phosphor-icons/react": "^2.1.10",
    "@sentry/nextjs": "^10.74.0",
    "@vercel/analytics": "^2.0.1",
    "firebase": "10.12.5",
    "firebase-admin": "12.3.1",
    "next": "14.2.35",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "resend": "^4.0.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@firebase/rules-unit-testing": "^3.0.4",
    "@next/bundle-analyzer": "^14.2.35",
    "@playwright/test": "1.46.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "6.4.8",
    "@testing-library/react": "16.0.0",
    "@testing-library/user-event": "14.5.2",
    "@types/node": "20.14.11",
    "@types/react": "18.3.3",
    "@types/react-dom": "18.3.0",
    "@vitejs/plugin-react": "4.3.1",
    "autoprefixer": "10.4.19",
    "cross-env": "^10.1.0",
    "eslint": "8.57.0",
    "eslint-config-next": "14.2.35",
    "firebase-tools": "^15.28.2",
    "husky": "^9.1.7",
    "jsdom": "24.1.1",
    "lint-staged": "^15.5.2",
    "postcss": "8.4.40",
    "tailwindcss": "3.4.7",
    "typescript": "5.5.4",
    "vitest": "2.0.5"
  }
}
