# Copy this file to .env.local and fill in real values before using
# Firebase Auth/Firestore or Paystack payments. Never commit .env.local
# (already covered by .gitignore's `.env*.local` rule).

# --- Firebase client config ---------------------------------------
# From Firebase Console → Project settings → General → Your apps → Web app.
# Safe to expose to the browser (NEXT_PUBLIC_ prefix required by Next.js).
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# --- Firebase Admin SDK (server-only, NEVER prefix with NEXT_PUBLIC_) ---
# From Firebase Console → Project settings → Service accounts →
# Generate new private key. Paste the private_key value as-is
# (with literal \n line breaks) — lib/firebase/admin.ts un-escapes it.
FIREBASE_ADMIN_PROJECT_ID=
FIREBASE_ADMIN_CLIENT_EMAIL=
FIREBASE_ADMIN_PRIVATE_KEY=

# --- Paystack --------------------------------------------------------
# From the Paystack dashboard → Settings → API Keys & Webhooks.
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=
PAYSTACK_SECRET_KEY=

# --- Resend (contact form notifications + parent portal invites) -----
# From the Resend dashboard → API Keys. CONTACT_FROM_EMAIL must be on a
# domain verified with Resend (or their sandbox address while testing).
# If any of these three are unset, the notification email is skipped.
# RESEND_API_KEY and CONTACT_FROM_EMAIL are also used to email new
# parent accounts their set-password link (see /admin/parents), to
# notify parents when their application's status changes (see /admin),
# to send a receipt after a successful fee payment, and to send weekly
# fee reminders (see CRON_SECRET below).
RESEND_API_KEY=
CONTACT_NOTIFY_EMAIL=
CONTACT_FROM_EMAIL=

# --- Admin access ------------------------------------------------------
# Comma-separated Firebase Auth emails. ADMIN_EMAILS gets full access to
# every /admin/* area. To give someone access to just one area instead,
# add them to that area's list below (additive — they don't also need to
# be in ADMIN_EMAILS). All must already exist as Firebase Auth users.
ADMIN_EMAILS=
ADMIN_EMAILS_ANNOUNCEMENTS=
ADMIN_EMAILS_APPLICATIONS=
ADMIN_EMAILS_INQUIRIES=
ADMIN_EMAILS_PARENTS=
ADMIN_EMAILS_EVENTS=
ADMIN_EMAILS_REPORTS=
ADMIN_EMAILS_DASHBOARD=

# --- Cron ----------------------------------------------------------------
# Any secret string. Vercel Cron automatically sends this as
# `Authorization: Bearer $CRON_SECRET` when calling /api/cron/* routes —
# set it here (and in the Vercel project's env vars) so the route can
# reject requests that don't come from Vercel's scheduler.
CRON_SECRET=
